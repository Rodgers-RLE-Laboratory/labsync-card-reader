[Unit]
Description=LabSync Card Reader
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/labsync-card-reader
EnvironmentFile=/opt/labsync-card-reader/.env.local
ExecStart=/usr/bin/node /opt/labsync-card-reader/.next/standalone/server.js
Restart=always
RestartSec=5
Environment=PORT=3000
Environment=HOSTNAME=0.0.0.0

[Install]
WantedBy=multi-user.target
