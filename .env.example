# MIT Card API credentials (required)
MIT_CARD_CLIENT_ID=
MIT_CARD_CLIENT_SECRET=

# Path to Firebase service account JSON key file (required)
FIREBASE_SERVICE_ACCOUNT_KEY=/opt/labsync-card-reader/firebase-service-account.json

# NEMO API configuration (required — check-ins fail if any of these are blank)
NEMO_URL=
NEMO_API_TOKEN=
NEMO_AREA_ID=

# Card ID format the kiosk's reader sends (optional, defaults to "auto"):
#   decimal — digits only (e.g. OmniKey 5427CK)
#   hex     — hex output (e.g. "0788c724ce" or "8236288a"); use this for hex
#             readers so serial numbers made only of digits aren't misread
#   auto    — all-digit IDs are treated as decimal, anything else as hex
CARD_READER_FORMAT=auto
