# MIT Card API credentials (required)
MIT_CARD_CLIENT_ID=
MIT_CARD_CLIENT_SECRET=

# Path to Firebase service account JSON key file (required)
FIREBASE_SERVICE_ACCOUNT_KEY=/opt/labsync-card-reader/firebase-service-account.json

# NEMO API configuration (optional — leave blank to disable NEMO integration)
NEMO_URL=
NEMO_API_TOKEN=
NEMO_AREA_ID=

# Display name shown on the kiosk screen (optional, defaults to "LabSync")
SITE_TITLE=LabSync
